{
  "seed": 230,
  "dataset_dir": "data/processed",
  "history_configs": ["config/history_2012.json", "config/seasonal.json"],
  "cutoff_minutes": 60,
  "min_previous_games": 5,
  "min_box_score_games": 5,
  "split_seasons": {"train": [2012, 2023], "dev": [2024, 2024], "test": [2025, 2025]},
  "selection_metric": "brier",
  "model_parameters": {
    "loss": "log_loss",
    "learning_rate": 0.05,
    "min_samples_leaf": 20,
    "subsample": 1.0,
    "n_iter_no_change": null
  },
  "candidates": [
    {"max_depth": 1, "n_estimators": 100},
    {"max_depth": 1, "n_estimators": 200},
    {"max_depth": 2, "n_estimators": 100},
    {"max_depth": 2, "n_estimators": 200}
  ],
  "bootstrap_replicates": 2000,
  "calibration_bins": 10
}
