    },
    "ResearchProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Attach only this scoped runtime role to the corresponding EC2 job.",
          "must": [
            "No root-backed sign-in material on workers."
          ]
        }
      },
      "Properties": {
        "Path": "/cs230/",
        "Roles": [
          {
            "Ref": "ResearchRole"
          }
        ]
      }
    },
    "TrainingProfile": {
      "Type": "AWS::IAM::InstanceProfile",
