      "Description": "Research execution role ARN",
      "Value": {
        "Fn::GetAtt": [
          "ResearchRole",
          "Arn"
        ]
      }
    },
    "ResearchInstanceProfile": {
      "Description": "Research instance profile name",
      "Value": {
        "Ref": "ResearchProfile"
      }
